---
import { DetailApp } from '../../components/detail/DetailApp';
import { getMockRecipes } from '../../lib/recipes/mock';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const recipes = getMockRecipes({ random: true });

  return recipes.map((recipe) => ({
    params: { id: recipe.id },
  }));
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}
---

<BaseLayout title="Recipe Detail">
  <main class="p-8">
    <DetailApp client:load recipeId={id} />
  </main>
</BaseLayout>
