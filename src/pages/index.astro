---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Dashboard from '~/components/Dashboard';
import { draft, getPlayer, newsByDate, players, team, trending } from '~/lib/data';
import { uniqueStories } from '~/lib/news/dedupe';
import { coverageGaps, facetCoverage, openSlots, rosterAlerts } from '~/lib/insights/cross-reference';
import { href } from '~/lib/url';

const articles = await getCollection('knowledge');

const alerts = rosterAlerts(newsByDate, team, players);
const alertIds = new Set(alerts.map((a) => a.item.id));
// Players the alert list already speaks for. Dropping their other coverage here
// is the same rule the alerts follow: one story per player, page-wide, so the
// digest is eight *new* things rather than the alerts restated by other outlets.
const alertedPlayerIds = new Set(alerts.flatMap((a) => a.item.players));
const digest = uniqueStories(
  newsByDate.filter(
    (item) => !alertIds.has(item.id) && !item.players.some((id) => alertedPlayerIds.has(id)),
  ),
).slice(0, 8);

const gaps = coverageGaps(
  facetCoverage(articles.map((a) => ({ facet: a.data.facet, updated: a.data.updated }))),
);

const slotLabels = new Map(team.format.rosterSlots.map((s) => [s.id, s.label]));
const topTargets = team.targets
  .filter((t) => t.priority === 1)
  .map((target) => ({
    target,
    player: getPlayer(target.playerId),
    slotLabel: slotLabels.get(target.slotId) ?? target.slotId,
  }));
---

<BaseLayout title="Dashboard" lede="What changed since you last looked, and what it means for your roster.">
  <Dashboard
    alerts={alerts}
    digest={digest}
    gaps={gaps}
    openSlots={openSlots(team)}
    topTargets={topTargets}
    newsCount={newsByDate.length}
    trending={trending}
    draft={draft}
    rosterEmpty={team.roster.every((r) => r.playerId === null)}
    rosteredPlayerIds={team.roster.map((r) => r.playerId).filter((id): id is string => Boolean(id))}
    links={{
      team: href('/team'),
      knowledge: href('/knowledge'),
      facet: (id: string) => href(`/knowledge/${id}`),
    }}
  />
</BaseLayout>
