---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BuildsApp from '~/components/builds/BuildsApp';
import { market, team, draft, trending } from '~/lib/data';
import { scoreArchetypes } from '~/lib/builds/fit';
import { planPicks } from '~/lib/builds/picks';
import { ARCHETYPES } from '~/lib/builds/archetypes';
import { href } from '~/lib/url';

const buildDocs = await getCollection('builds');
const fits = scoreArchetypes({ format: team.format, market, draft });
const plans = Object.fromEntries(
  ARCHETYPES.map((a) => [
    a.id,
    planPicks({ archetype: a, market, draft, format: team.format, trending }),
  ]),
);

const docById = new Map(buildDocs.map((doc) => [doc.data.archetype, doc]));

const builds = fits
  .map((fit) => {
    const doc = docById.get(fit.id);
    if (!doc) return null;
    return {
      fit,
      title: doc.data.title,
      tagline: doc.data.tagline,
      thesis: doc.data.thesis,
      worksWhen: doc.data.worksWhen,
      failsWhen: doc.data.failsWhen,
      sources: doc.data.sources,
      articleHref: href(`/knowledge/roster-construction/superflex-positional-builds`),
      picks: plans[fit.id] ?? [],
    };
  })
  .filter((b): b is NonNullable<typeof b> => b !== null);

const links = { team: href('/team'), knowledge: href('/knowledge') };

const startDate = draft.startTime
  ? new Date(draft.startTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : 'a date not yet set';

const lede = `Every named build archetype for ${team.leagueName}, scored against this format and this draft slot, with a full 30-round pick sheet per build. Startup is ${startDate}.`;
---

<BaseLayout title="Builds" lede={lede} tone="amber">
  <BuildsApp client:load builds={builds} market={market} links={links} />
</BaseLayout>
