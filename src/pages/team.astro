---
import BaseLayout from '~/layouts/BaseLayout.astro';
import TeamApp from '~/components/TeamApp';
import { depthRankById, draft, players, team } from '~/lib/data';

const empty = team.roster.every((r) => r.playerId === null);
const lede = empty
  ? 'Empty slots grade as holes. Refresh from Sleeper, then this page shows where the 2026 roster is weak.'
  : 'Where the 2026 roster is weak, then the slots, alternatives, and what you have left to spend.';
---

<BaseLayout title={team.teamName} lede={lede}>
  <TeamApp
    client:load
    committed={team}
    players={players}
    draft={draft}
    depthRanks={depthRankById}
  />
</BaseLayout>
