---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsArchive from '~/components/NewsArchive';
import { newsByDate, team, feeds } from '~/lib/data';

const watchedPlayerIds = [
  ...team.roster.map((r) => r.playerId).filter((id): id is string => Boolean(id)),
  ...team.targets.map((t) => t.playerId),
];

const enabledFeeds = feeds.filter((f) => f.enabled);
const lastUpdated = newsByDate[0]?.publishedAt;
---

<BaseLayout
  title="News"
  lede="Every item the pipeline has gathered. The side panel is the condensed view of this same archive."
>
  <p class="mb-4 text-xs text-muted">
    {enabledFeeds.length} feed{enabledFeeds.length === 1 ? '' : 's'} · {newsByDate.length} item{
      newsByDate.length === 1 ? '' : 's'
    } on file{lastUpdated ? ` · newest ${new Date(lastUpdated).toLocaleDateString('en-US')}` : ''}
  </p>

  <NewsArchive client:load items={newsByDate} watchedPlayerIds={watchedPlayerIds} />

  <section class="mt-10 border-t border-line pt-5">
    <h2 class="label mb-2">Sources</h2>
    <ul class="grid gap-1 text-sm sm:grid-cols-2">
      {
        enabledFeeds.map((feed) => (
          <li class="flex items-baseline justify-between gap-3 border-b border-line py-1">
            <a href={feed.url} target="_blank" rel="noreferrer" class="hover:underline">
              {feed.name}
            </a>
            <span class="label">{feed.category}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-xs text-muted">
      Edit <code class="font-mono">data/feeds.json</code> to add or park a source.
    </p>
  </section>
</BaseLayout>
