---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PicksApp from '~/components/PicksApp';
import { market, trending, players, draft, team, depthRankById } from '~/lib/data';
import { buildPositionBoards } from '~/lib/picks/board';
import { href } from '~/lib/url';

const data = buildPositionBoards({
  market,
  trending,
  players,
  draft,
  format: team.format,
  depthRankById,
});

const links = { team: href('/team'), builds: href('/builds') };

const lede =
  'Every position, most popular first — expert consensus for draft day, Sleeper add counts for the waiver wire. Players already drafted or rostered in this league are marked, so the next name down is one glance away.';
---

<BaseLayout title="Picks" lede={lede} tone="pink">
  <PicksApp client:load data={data} links={links} />
</BaseLayout>
