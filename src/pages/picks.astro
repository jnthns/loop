---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PicksApp from '~/components/PicksApp';
import {
  market,
  trending,
  players,
  draft,
  team,
  depthRankById,
  profiles,
} from '~/lib/data';
import { buildPositionBoards } from '~/lib/picks/board';
import { buildPickRecommendations } from '~/lib/picks/recommend';
import { href } from '~/lib/url';

const data = buildPositionBoards({
  market,
  trending,
  players,
  draft,
  format: team.format,
  depthRankById,
});

const recs = buildPickRecommendations({
  market,
  trending,
  players,
  draft,
  team,
  profiles,
  depthRankById,
});

const links = { team: href('/team'), builds: href('/builds') };

const lede =
  'Who to take next, scored against your own roster. Every available player is weighed on two market sources, the holes in your lineup, this league’s scoring settings, and the published age curve for his position — with the arithmetic shown on every row. The old consensus board is still a click away.';
---

<BaseLayout title="Picks" lede={lede} tone="pink">
  <PicksApp client:load data={data} recs={recs} links={links} />
</BaseLayout>
