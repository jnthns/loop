---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getFacet } from '~/lib/knowledge/facets';
import { href } from '~/lib/url';
import { absoluteDate, daysSince } from '~/lib/time';

export const getStaticPaths = (async () => {
  const articles = await getCollection('knowledge');
  return articles.map((entry) => {
    const [facet, slug] = entry.id.split('/');
    return { params: { facet, slug }, props: { entry } };
  });
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const facet = getFacet(entry.data.facet);
const age = daysSince(entry.data.updated);
---

<BaseLayout title={entry.data.title} lede={entry.data.summary}>
  <p class="mb-5 flex flex-wrap gap-x-2 text-xs">
    <a href={href('/knowledge')} class="text-accent hover:underline">Knowledge</a>
    <span class="text-muted">/</span>
    <a href={href(`/knowledge/${entry.data.facet}`)} class="text-accent hover:underline">
      {facet?.title ?? entry.data.facet}
    </a>
  </p>

  <dl
    data-testid="article-meta"
    class="mb-6 grid grid-cols-2 gap-x-6 gap-y-2 border border-line bg-surface-alt p-3 sm:grid-cols-4"
  >
    <div>
      <dt class="label">Facet</dt>
      <dd class="text-sm">{facet?.title ?? entry.data.facet}</dd>
    </div>
    <div>
      <dt class="label">Confidence</dt>
      <dd class="text-sm">{entry.data.confidence}</dd>
    </div>
    <div>
      <dt class="label">Updated</dt>
      <dd class="text-sm" data-numeric>{absoluteDate(entry.data.updated)}</dd>
    </div>
    <div>
      <dt class="label">Age</dt>
      <dd class="text-sm" data-numeric>{Number.isFinite(age) ? `${age}d` : '—'}</dd>
    </div>
  </dl>

  <article class="prose-article text-[15px]">
    <Content />
  </article>

  <section class="mt-10 border-t border-line pt-5" data-testid="sources">
    <h2 class="label mb-2">Sources ({entry.data.sources.length})</h2>
    <ol class="space-y-1 text-[13px]">
      {
        entry.data.sources.map((source) => (
          <li>
            <a
              href={source.url}
              target="_blank"
              rel="noreferrer"
              class="text-accent hover:underline"
            >
              {source.label}
            </a>
          </li>
        ))
      }
    </ol>
    <p class="mt-3 max-w-2xl text-[11px] text-muted">
      Every article in this library must cite at least one source; the build fails otherwise.
      Sources are references the reasoning draws on, not proof of any specific number — check
      anything you are about to trade on.
    </p>
  </section>

  {
    entry.data.tags.length > 0 && (
      <p class="mt-6 text-[11px] text-muted">{entry.data.tags.join(' · ')}</p>
    )
  }
</BaseLayout>
