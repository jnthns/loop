---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { FACETS } from '~/lib/knowledge/facets';
import { facetTone } from '~/lib/ui/tone';
import { href } from '~/lib/url';
import { absoluteDate, daysSince } from '~/lib/time';

const articles = await getCollection('knowledge');

const facets = FACETS.map((facet) => {
  const entries = articles
    .filter((a) => a.data.facet === facet.id)
    .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
  return { ...facet, entries, newest: entries[0]?.data.updated ?? null };
});

const total = articles.length;
const thinnest = [...facets].sort((a, b) => a.entries.length - b.entries.length)[0];
---

<BaseLayout
  title="Knowledge"
  lede="The dynasty playbook, organized by facet. Written and revised by the loop; every article cites its sources."
>
  <p class="mb-6 flex flex-wrap gap-1.5">
    <span class="chip chip-tone">
      {total} article{total === 1 ? '' : 's'}
    </span>
    <span class="chip">{FACETS.length} facets</span>
    {
      thinnest && thinnest.entries.length === 0 && (
        <span class="chip">thinnest coverage: {thinnest.title}</span>
      )
    }
  </p>

  <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    {
      facets.map((facet) => (
        <li data-testid="facet-card" data-facet={facet.id} data-tone={facetTone(facet.id)}>
          <a
            href={href(`/knowledge/${facet.id}`)}
            class="card-tone card-link flex h-full flex-col p-4"
          >
            <div class="flex items-start justify-between gap-3">
              <span
                class="grid size-8 shrink-0 place-items-center rounded-[0.5rem] border border-tone-line bg-tone-soft text-[13px] font-black text-tone"
                aria-hidden="true"
              >
                {facet.title.slice(0, 2).toUpperCase()}
              </span>
              <span class="badge" data-numeric>
                {facet.entries.length}
              </span>
            </div>
            <h2 class="mt-2.5 text-[0.9375rem] font-bold">{facet.title}</h2>
            <p class="mt-1 text-[13px] text-muted">{facet.blurb}</p>
            <p class="mt-3 text-[11px] text-muted">
              {facet.newest
                ? `Updated ${absoluteDate(facet.newest)} · ${daysSince(facet.newest)}d ago`
                : 'No articles yet — the curator loop fills gaps first.'}
            </p>
          </a>
        </li>
      ))
    }
  </ul>

  <section class="mt-12" aria-labelledby="how-this-grows">
    <div class="section-head">
      <div class="section-head__row">
        <h2 id="how-this-grows" class="section-head__title">How this grows</h2>
      </div>
    </div>
    <p class="max-w-2xl text-[13px] text-muted">
      The <code class="font-mono">knowledge-curator</code> loop writes or revises exactly one
      article per pass, starting with the thinnest or stalest facet, and grounds it in items
      from the news archive. An article with no sources fails the build, so nothing here is
      asserted without a citation.
    </p>
  </section>
</BaseLayout>
