# Loop harness configuration. Copy to .env (which is git-ignored) and edit.
# NEVER commit real secrets. .env must stay out of version control.

# --- Which agent runs each pass ---------------------------------------------
# The command invoked with the loop prompt as a single argument. Examples:
#   AGENT_CMD="cursor-agent -p"
#   AGENT_CMD="claude -p --dangerously-skip-permissions"   # unattended
#   AGENT_CMD="codex exec"
# Leave unset to auto-probe (cursor-agent > claude > codex), or use `echo` for a
# safe DRY RUN that performs no real work.
AGENT_CMD=echo

# Which loop to run (see loops/). Defaults to the main build loop.
LOOP_FILE=loops/build.md

# --- The three hard stops (guardrails) --------------------------------------
MAX_ITERATIONS=25          # ceiling on passes
MAX_NO_PROGRESS=3          # halt after this many passes with no new commit
BUDGET_USD=5               # hard spend ceiling for one run
COST_PER_ITERATION_USD=0.25   # rough per-pass estimate added to the ledger

# --- Maker-checker split ----------------------------------------------------
# Command that runs the independent checker subagent (given a prompt as $1).
# Ideally a stronger model / higher reasoning effort than the maker. If unset,
# verify.sh runs only the mechanical check (a weaker gate).
# CHECKER_CMD="claude -p --model <stronger-model>"

# --- Model provider credentials (examples — fill only what your CLI needs) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- App: Gemini recipe generation (server-only, never commit real key) --------
GEMINI_API_KEY=

# --- Escape hatches (use deliberately) --------------------------------------
# ALLOW_DIRTY=1            # allow the loop to start with an uncommitted tree
