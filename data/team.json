    {
      "id": "t-sflex-daniels-tier",
      "slotId": "qb-1",
      "playerId": "caleb-williams",
      "priority": 1,
      "rationale": "Superflex punishes one-QB rosters more than any other format decision. A second startable QB on a rookie deal is the highest-leverage upgrade available.",
      "cost": "2027 1st + bench WR"
    },
    {
      "id": "t-sflex-mahomes",
      "slotId": "qb-1",
      "playerId": "patrick-mahomes",
      "priority": 2,
      "rationale": "Buys a bigger win-now edge at a shorter window. Only correct if the rest of the roster says contend.",
      "cost": "2027 1st + 2028 1st"
    },
    {
      "id": "t-sflex-allen",
      "slotId": "qb-1",
      "playerId": "josh-allen",
      "priority": 3,
      "rationale": "Same trade-off as Mahomes with more rushing floor and the same age problem. Compare offers, do not chase the name.",
      "cost": "2027 1st + RB2"
    },
    {
      "id": "t-te-bowers",
      "slotId": "te-1",
      "playerId": "brock-bowers",
      "priority": 1,
      "rationale": "TE premium (0.5 PPR bonus) makes an every-down young TE a genuine positional advantage rather than a luxury.",
      "cost": "WR3 + 2027 1st"
    },
    {
      "id": "t-te-mcbride",
      "slotId": "te-1",
      "playerId": "trey-mcbride",
      "priority": 2,
      "rationale": "Most of the TE-premium benefit at a fraction of the acquisition cost. The efficient version of the same upgrade.",
      "cost": "2027 2nd + bench piece"
    },
    {
      "id": "t-rb2-jeanty",
      "slotId": "rb-2",
      "playerId": "ashton-jeanty",
      "priority": 1,
      "rationale": "Youngest usable RB2 available. Note the market prices first-round rookie RBs at their absolute peak — this is a buy only at a discount.",
