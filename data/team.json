    },
    {
      "id": "t-rb2-barkley",
      "slotId": "rb-2",
      "playerId": "saquon-barkley",
      "priority": 2,
      "rationale": "Pure win-now rental. Acquire only with a contending roster and never at a first-round price.",
      "cost": "2027 2nd"
    },
